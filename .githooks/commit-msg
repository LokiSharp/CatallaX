#!/usr/bin/env bash
# Validate commit subjects against Conventional Commits.
set -euo pipefail

message_file="${1:?commit message file is required}"
subject="$(sed -n '1p' "$message_file")"

# Allow empty subject only if the whole message is empty (git may abort elsewhere).
if [[ -z "${subject// }" ]]; then
  exit 0
fi

conventional_pattern='^(feat|fix|docs|style|refactor|perf|test|build|ci|chore|revert)(\([a-z0-9][a-z0-9._/-]*\))?!?: .+'
generated_pattern='^(Merge |Revert "|(fixup|squash|amend)! )'

if [[ "$subject" =~ $conventional_pattern ]] || [[ "$subject" =~ $generated_pattern ]]; then
  exit 0
fi

cat >&2 <<'EOF'
[FAIL] commit subject does not follow Conventional Commits

Expected:
  <type>[optional scope][!]: <description>

Allowed types:
  feat fix docs style refactor perf test build ci chore revert

Examples:
  feat(db): add idempotent market data upsert
  fix(config): load database URL from settings
  chore(devbox): pin local PostgreSQL port
EOF
exit 1
