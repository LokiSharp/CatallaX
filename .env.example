CATALLAX_DATABASE_URL=postgresql+psycopg://catallax:catallax@localhost:15432/catallax_dev
CATALLAX_ENV=development

# Market-data provider (only longbridge for now)
CATALLAX_MARKET_DATA_PROVIDER=longbridge

# Longbridge OpenAPI credentials
# Also accepted as LONGBRIDGE_APP_KEY / LONGBRIDGE_APP_SECRET / LONGBRIDGE_ACCESS_TOKEN
CATALLAX_LONGBRIDGE_APP_KEY=
CATALLAX_LONGBRIDGE_APP_SECRET=
CATALLAX_LONGBRIDGE_ACCESS_TOKEN=
